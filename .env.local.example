NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin authentication — set a strong password before deploying
ADMIN_PASSWORD=change-me-before-deploy
# Secret used to sign the session cookie — generate with: openssl rand -hex 32
ADMIN_COOKIE_SECRET=change-me-before-deploy

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in your Resend account
EMAIL_FROM=GreeceClean <noreply@greececlean.gr>
# Expected verified domain for warning checks
RESEND_VERIFIED_DOMAIN=greececlean.gr

# Webhook secret — protects /api/send-report-email from external calls
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-before-deploy

# Reverse geocoding
GEOCODER_PROVIDER=nominatim
NOMINATIM_USER_AGENT=GreeceClean/1.0 (contact@example.com)
